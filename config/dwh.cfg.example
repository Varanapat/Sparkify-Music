# Copy to config/dwh.cfg and fill in real values. config/dwh.cfg is gitignored.

[AWS]
REGION = us-east-1

[CLUSTER]
HOST     = <redshift-endpoint>.us-east-1.redshift.amazonaws.com
DB_NAME  = sparkify
DB_USER  = <db-user>
DB_PASSWORD = <db-password>
DB_PORT  = 5439

[IAM_ROLE]
ARN = arn:aws:iam::<account-id>:role/<redshift-s3-read-role>

[S3]
LOG_DATA      = s3://sparkify-raw-<group>/log_data
LOG_JSONPATH  = s3://sparkify-raw-<group>/log_json_path.json
SONG_DATA     = s3://sparkify-raw-<group>/song_data
